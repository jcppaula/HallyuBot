# =============================================
# HallyuBot V3 - Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha com seus tokens reais.
# NUNCA suba o arquivo .env para o GitHub!

# Token do Bot do Discord
DISCORD_TOKEN=cole_seu_token_aqui

# IDs dos Canais do Discord
CANAL_URGENTE_ID=cole_o_id_do_canal_plantao_urgente
CANAL_RESUMO_ID=cole_o_id_do_canal_resumo_diario
CANAL_LOGS_ID=cole_o_id_do_canal_de_logs_secreto
ADMIN_USER_ID=cole_o_seu_id_do_discord_aqui

# Chave da API do Google Gemini (1.5 Flash)
GEMINI_API_KEY=cole_sua_chave_aqui

# Chave da API da OpenAI (GPT-4o mini)
OPENAI_API_KEY=cole_sua_chave_aqui

# Chave da YouTube Data API v3
YOUTUBE_API_KEY=cole_sua_chave_aqui

# Token da Apify API (Instagram/TikTok)
APIFY_API_TOKEN=cole_seu_token_aqui
